# Google AI Studio key for the sorting and summarising routes.
# Create one at https://aistudio.google.com/apikey — a plain AIza... string.
# Not an OAuth client id/secret: those sign users into Google accounts and
# cannot authenticate Gemini calls.
GOOGLE_GENERATIVE_AI_API_KEY=

# Single-user password gate. Leave unset and the gate is off entirely, which
# is fine locally. Set it in production — /api/sort costs money to call.
APP_PASSWORD=
